# Database configuration
# Name of the main application database
PG_DB=example_db

# Name of the admin database used for management operations
PG_ADMIN_DB=postgres

# Host and port of the PostgreSQL server
PG_HOST=localhost
PG_PORT=5432

# JDBC URL used by Spark to connect to PostgreSQL
PG_URL=jdbc:postgresql://localhost:5432/example_db

# Database user and password (do not use real credentials here)
PG_USER=example_user
PG_PASSWORD=example_password

# JDBC driver class for PostgreSQL
PG_DRIVER=org.postgresql.Driver

# Spark and Delta configuration
PG_JDBC=false
DELTA_ENABLED=false

# JWT and security
JWT_SECRET=change_this_jwt_secret

# External services
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_KEY=example_api_key

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
